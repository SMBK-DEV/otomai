<Window x:Class="NYROX.Desktop.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX • Controller" Width="1240" Height="820"
        MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#10151D" Foreground="#E8EAF0">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#263342"/><Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#536477"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0D141C"/><Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#536477"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#0D141C"/><Setter Property="Foreground" Value="#17212B"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#0D141C"/><Setter Property="Foreground" Value="#E8EAF0"/><Setter Property="RowBackground" Value="#15202B"/><Setter Property="AlternatingRowBackground" Value="#1A2734"/><Setter Property="BorderBrush" Value="#354454"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" Background="#18212C" BorderBrush="#354454" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,12">
            <StackPanel><TextBlock Text="NYROX CONTROLLER" FontSize="23" FontWeight="Bold" Foreground="#69D4B2"/><TextBlock Text="Group orchestration • per-account Lua runtime • scheduler • live state" Foreground="#9AA8B8" Margin="0,4,0,0"/></StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#0D141C" BorderBrush="#354454" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Ready." Foreground="#AAB7C5" TextWrapping="Wrap"/></Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Column="0" Background="#18212C" BorderBrush="#354454" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Live accounts" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Select one or more connected accounts. Ctrl/Shift-click selects multiple." Foreground="#9AA8B8" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,10"/>
                        <Button Content="Refresh accounts and scripts" Click="Refresh_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <DataGrid x:Name="RuntimeGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" Margin="0,10,0,0"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#18212C" BorderBrush="#354454" BorderThickness="1" CornerRadius="7" Padding="14" Margin="8,0,0,8">
                <StackPanel>
                    <TextBlock Text="Group configuration" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Group name" Foreground="#9AA8B8" FontSize="11"/>
                    <TextBox x:Name="GroupNameBox" Height="32"/>
                    <TextBlock Text="Lua script" Foreground="#9AA8B8" FontSize="11"/>
                    <ComboBox x:Name="ScriptCombo" Height="32"/>
                    <TextBlock Text="Callback name" Foreground="#9AA8B8" FontSize="11"/>
                    <TextBox x:Name="CallbackBox" Text="move" Height="32"/>
                    <TextBlock Text="Interval (milliseconds)" Foreground="#9AA8B8" FontSize="11"/>
                    <TextBox x:Name="IntervalBox" Text="1000" Height="32"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Create / update group" Click="SaveGroup_Click"/>
                        <Button Content="Delete group" Click="DeleteGroup_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Saved groups" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="220"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="▶ Start selected group" Click="StartGroup_Click" Background="#145A46"/>
                        <Button Content="■ Stop selected group" Click="StopGroup_Click" Background="#713B35"/>
                    </WrapPanel>
                    <TextBlock Text="Start loads the selected Lua script for each account, then starts its saved callback schedule. Only use reviewed scripts with bounded callbacks." Foreground="#D9B36C" FontSize="11" TextWrapping="Wrap" Margin="3,8,3,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#18212C" BorderBrush="#354454" BorderThickness="1" CornerRadius="7" Padding="12">
                <TextBlock Text="Groups are saved locally. Start/Stop commands use the existing authenticated NYROX Control API and existing per-account Lua runtime; no second game connection is created. A group is an orchestration layer, not a guarantee that every in-game action succeeds." Foreground="#9AA8B8" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>