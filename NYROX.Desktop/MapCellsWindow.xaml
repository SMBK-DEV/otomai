<Window x:Class="NYROX.Desktop.MapCellsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX • Map Cells" Width="1120" Height="820"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="MAP CELLS" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="MapInfoText" Text="Waiting for live map data…" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0"/>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="● Current cell" Foreground="#F4C542" Margin="0,0,14,0"/>
            <TextBlock Text="● Interactive" Foreground="#38BDF8" Margin="0,0,14,0"/>
            <TextBlock Text="● Map-change data" Foreground="#FB923C" Margin="0,0,14,0"/>
            <TextBlock Text="● Occupied" Foreground="#C084FC" Margin="0,0,14,0"/>
            <TextBlock Text="● Walkable" Foreground="#4ADE80" Margin="0,0,14,0"/>
            <TextBlock Text="● Blocked" Foreground="#94A3B8"/>
        </WrapPanel>
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CellsGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="28"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Cell_Click" Tag="{Binding}" Width="34" Height="29" Padding="0" Margin="1"
                                    FontSize="9" BorderThickness="1" BorderBrush="#263445"
                                    Content="{Binding Id}" ToolTip="{Binding Tooltip}"
                                    Background="{Binding Brush}" Foreground="#F8FAFC"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="3" Background="#0D141C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,10,0,0">
            <TextBlock x:Name="CellDetailsText" Text="Select a cell to inspect its properties." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
