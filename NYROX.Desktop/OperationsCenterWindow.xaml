<Window x:Class="NYROX.Desktop.OperationsCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX • Operations Center" Width="1320" Height="860"
        MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterOwner"
        Background="#10151D" Foreground="#E8EAF0">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#263342"/><Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#536477"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0D141C"/><Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#536477"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#0D141C"/><Setter Property="Foreground" Value="#17212B"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#0D141C"/><Setter Property="Foreground" Value="#E8EAF0"/><Setter Property="RowBackground" Value="#15202B"/><Setter Property="AlternatingRowBackground" Value="#1A2734"/><Setter Property="BorderBrush" Value="#354454"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="#E8EAF0"/></Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" Background="#18212C" BorderBrush="#354454" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,12">
            <Grid><StackPanel><TextBlock Text="NYROX OPERATIONS CENTER" FontSize="23" FontWeight="Bold" Foreground="#69D4B2"/><TextBlock Text="Account lifecycle • subscriptions • proxies • character planning • runtime control" Foreground="#9AA8B8" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="SummaryText" Text="0 accounts • 0 proxies • 0 subscriptions" Foreground="#C7D0DA"/><TextBlock Text="Local workspace — sensitive credentials and payment PINs are never stored here." Foreground="#9AA8B8" FontSize="10" HorizontalAlignment="Right"/></StackPanel></Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#0D141C" BorderBrush="#354454" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Ready." Foreground="#AAB7C5"/></Border>
        <TabControl>
            <TabItem Header="Accounts">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel><TextBox x:Name="AccountLoginBox" Width="190" ToolTip="Account login / label" /><TextBox x:Name="AccountServerBox" Width="130" Text="Draconiros" ToolTip="Server"/><TextBox x:Name="AccountEmailBox" Width="220" ToolTip="Contact email (optional; no password)" /><Button Content="Add account record" Click="AddAccount_Click"/><Button Content="Remove selected" Click="RemoveAccount_Click"/><Button Content="Save workspace" Click="Save_Click"/></WrapPanel>
                    <DataGrid x:Name="AccountsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="3,10,3,3"/>
                </Grid>
            </TabItem>
            <TabItem Header="Account Creator">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Existing account-creation code is already present in BubbleBot.AccountCreation and tools/account-creator. This screen links completed, legitimately registered accounts into the shared NYROX account registry. Use the official Ankama flow for registration and verification; no CAPTCHA, WAF, SMS or anti-abuse bypass is launched from this panel." TextWrapping="Wrap" Foreground="#B5C2D0" Margin="3,3,3,14"/>
                    <WrapPanel Grid.Row="1"><TextBox x:Name="NewAccountAliasBox" Width="190" ToolTip="Account label"/><TextBox x:Name="NewAccountEmailBox" Width="230" ToolTip="Email address"/><TextBox x:Name="NewAccountServerBox" Width="140" Text="Draconiros" ToolTip="Preferred server"/><Button Content="Add registration task" Click="QueueAccount_Click"/><Button Content="Open Ankama registration" Click="OpenRegistration_Click"/><Button Content="Mark registration complete" Click="CompleteRegistration_Click"/><Button Content="Sync accounts from Zaap" Click="SyncAccountsFromZaap_Click"/></WrapPanel>
                    <DataGrid x:Name="RegistrationGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="3,10,3,3"/>
                </Grid>
            </TabItem>
            <TabItem Header="Proxies">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Proxy profiles are stored as endpoint metadata only. Authentication secrets are intentionally excluded; assignment is a saved plan and is not yet wired into the game's transport." Foreground="#D9B36C" TextWrapping="Wrap" Margin="3,3,3,10"/>
                    <WrapPanel Grid.Row="1"><TextBox x:Name="ProxyNameBox" Width="150" ToolTip="Proxy label"/><ComboBox x:Name="ProxyTypeBox" Width="105"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="SOCKS5"/></ComboBox><TextBox x:Name="ProxyHostBox" Width="180" ToolTip="Host / IP"/><TextBox x:Name="ProxyPortBox" Width="85" ToolTip="Port"/><TextBox x:Name="ProxyAccountBox" Width="170" ToolTip="Assigned account label (optional)"/><Button Content="Add proxy" Click="AddProxy_Click"/><Button Content="Apply selected SOCKS5 to account" Click="ApplyProxy_Click"/><Button Content="Remove selected" Click="RemoveProxy_Click"/></WrapPanel>
                    <DataGrid x:Name="ProxiesGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="3,10,3,3"/>
                </Grid>
            </TabItem>
            <TabItem Header="Subscriptions">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Track PaySafeCard payments by reference/status only — never enter or save a PSC PIN. Ogrine renewals are reminders/plans until an official supported purchase flow is verified; no automatic spending is performed." Foreground="#D9B36C" TextWrapping="Wrap" Margin="3,3,3,10"/>
                    <WrapPanel Grid.Row="1"><TextBox x:Name="SubAccountBox" Width="150" ToolTip="Account label"/><ComboBox x:Name="SubProviderBox" Width="130"><ComboBoxItem Content="PaySafeCard"/><ComboBoxItem Content="Ogrines"/><ComboBoxItem Content="Other"/></ComboBox><TextBox x:Name="SubAmountBox" Width="90" ToolTip="Amount"/><ComboBox x:Name="SubCurrencyBox" Width="85"><ComboBoxItem Content="EUR"/><ComboBoxItem Content="MAD"/><ComboBoxItem Content="Ogrines"/></ComboBox><TextBox x:Name="SubReferenceBox" Width="150" ToolTip="Non-sensitive payment reference"/><TextBox x:Name="SubExpiryBox" Width="120" ToolTip="Expiry YYYY-MM-DD"/><Button Content="Add subscription record" Click="AddSubscription_Click"/><Button Content="Remove selected" Click="RemoveSubscription_Click"/></WrapPanel>
                    <DataGrid x:Name="SubscriptionsGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="3,10,3,3"/>
                </Grid>
            </TabItem>
            <TabItem Header="Characters">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel><TextBox x:Name="CharacterAccountBox" Width="160" ToolTip="Account label"/><TextBox x:Name="CharacterNameBox" Width="160" ToolTip="Character name"/><ComboBox x:Name="CharacterClassBox" Width="150"><ComboBoxItem Content="Cra"/><ComboBoxItem Content="Panda"/><ComboBoxItem Content="Roublard"/><ComboBoxItem Content="Feca"/><ComboBoxItem Content="Eniripsa"/><ComboBoxItem Content="Other"/></ComboBox><TextBox x:Name="CharacterServerBox" Width="130" Text="Draconiros"/><Button Content="Add character plan" Click="AddCharacter_Click"/><Button Content="Remove selected" Click="RemoveCharacter_Click"/></WrapPanel>
                    <DataGrid x:Name="CharactersGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="3,10,3,3"/>
                </Grid>
            </TabItem>
            <TabItem Header="Controller &amp; Map">
                <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Runtime controls already available in NYROX: account connect/disconnect, Lua load/stop, per-account scheduler, F10 Admin, game-interface observer, Map Cells Inspector and Protocol Sniffer. Use the main dashboard and F10 for live actions." TextWrapping="Wrap" Foreground="#B5C2D0" Margin="3,3,3,14"/>
                    <WrapPanel Grid.Row="1"><Button Content="Open F10 Admin" Click="OpenAdmin_Click"/><Button Content="Open NYROX Controller" Click="OpenController_Click"/><Button Content="Refresh runtime accounts" Click="RefreshRuntime_Click"/><Button Content="Open Map Cells" Click="OpenMap_Click"/></WrapPanel>
                    <Border Grid.Row="2" Background="#18212C" BorderBrush="#354454" BorderThickness="1" CornerRadius="7" Padding="14" Margin="3,12,3,3"><StackPanel><TextBlock Text="Live runtime snapshot" FontSize="16" FontWeight="SemiBold"/><DataGrid x:Name="RuntimeGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="280" Margin="0,10,0,0"/><TextBlock Text="Map analytics are read from the connected game session when its map observer is available. This tab does not invent map coordinates or claim that a planned proxy is active." TextWrapping="Wrap" Foreground="#9AA8B8" Margin="0,10,0,0"/></StackPanel></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>