<Application x:Class="NYROX.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1017"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#111A24"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#243342"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8F0F7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8FA2B5"/>
        <SolidColorBrush x:Key="Accent" Color="#25C58A"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#172431"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
