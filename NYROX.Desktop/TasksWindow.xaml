<Window x:Class="NYROX.Desktop.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX • Task Monitor" Height="560" Width="900"
        MinHeight="420" MinWidth="700" WindowStartupLocation="CenterOwner"
        Background="#101820" Foreground="#E8EEF5">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Task &amp; Scheduler Monitor" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Live callback schedules running per account. Stop is graceful and waits for the current callback."
                           Foreground="#91A0B2" Margin="0,5,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Width="100" Height="34" Click="Refresh_Click"/>
        </DockPanel>
        <DataGrid x:Name="SchedulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" Background="#0D141C" Foreground="#E8EEF5"
                  RowBackground="#111A24" AlternatingRowBackground="#14202B" BorderBrush="#2A3948"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="1.2*"/>
                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="1.2*"/>
                <DataGridTextColumn Header="Callback" Binding="{Binding CallbackName}" Width="1.2*"/>
                <DataGridTextColumn Header="Interval (ms)" Binding="{Binding IntervalMs}" Width="110"/>
                <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedAt}" Width="1.4*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Loading schedules…" Foreground="#91A0B2" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Stop selected schedule" Padding="12,7" Click="Stop_Click"/>
        </DockPanel>
    </Grid>
</Window>