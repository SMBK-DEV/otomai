<Window x:Class="NYROX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX Control Center" Height="850" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E151E" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NYROX" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="CONTROL CENTER" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="2,0,0,28"/>
                    <Button Content="Overview" HorizontalContentAlignment="Left" Click="Refresh_Click"/>
                    <Button Content="Accounts" HorizontalContentAlignment="Left" Click="Accounts_Click"/>
                    <Button Content="Scripts &amp; Profiles" HorizontalContentAlignment="Left" Click="Scripts_Click"/>
                    <Button Content="Task Monitor" HorizontalContentAlignment="Left" Click="Tasks_Click"/>
                    <Button Content="Route Planner" HorizontalContentAlignment="Left" Click="Routes_Click"/>
                    <Button Content="Live Logs" HorizontalContentAlignment="Left" Click="Logs_Click"/>
                    <Button Content="Game Data" HorizontalContentAlignment="Left" Click="GameData_Click"/>
                    <Button Content="Settings" HorizontalContentAlignment="Left" Click="Settings_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,0,0,14"/>
                    <TextBlock Text="LOCAL CONTROL API" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="ApiStatusText" Text="Starting…" Foreground="#E9B66B" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="127.0.0.1 • Token protected" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Manage your NYROX runtime and Dofus Unity sessions." Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="↻  Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="LIVE ACCOUNTS" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock x:Name="AccountCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Runtime sessions" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="CONNECTED" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock x:Name="ConnectedCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Confirmed connections" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="IN FIGHT" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock x:Name="FightCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Live fight state" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="15">
                    <StackPanel><TextBlock Text="LUA SCRIPTS" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock x:Name="ScriptCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Available in Scripts folder" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Account connection" FontWeight="SemiBold"/>
                            <TextBlock Text="Connect an account configured in the local Zaap/BubbleBot account store." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="UsernameBox" Grid.Column="1" Width="220" Height="34" VerticalContentAlignment="Center" Margin="12,0,8,0" Background="#0D141C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}" CaretBrush="White" Padding="8" ToolTip="Account login"/>
                        <Button Grid.Column="2" Content="Connect account" Margin="0" Click="Connect_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,12,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Accounts" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="  •  live runtime state • Ctrl/Shift-click for multiple accounts" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
                                      Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24" AlternatingRowBackground="#14202B"
                                      BorderBrush="{StaticResource PanelBorder}" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      SelectionChanged="AccountsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Account" Binding="{Binding Id}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="55"/>
                                    <DataGridCheckBoxColumn Header="Online" Binding="{Binding Connected}" Width="65"/>
                                    <DataGridCheckBoxColumn Header="Fight" Binding="{Binding InFight}" Width="55"/>
                                    <DataGridTextColumn Header="Map ID" Binding="{Binding MapId}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Selected account" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedAccountText" Text="Select an account from the list." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <TextBlock Text="Lua script" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <ComboBox x:Name="ScriptCombo" Height="34" Margin="0,6,0,12" Background="#0D141C" Foreground="#101820"/>
                            <WrapPanel>
                                <Button Content="Load script" Click="LoadScript_Click"/>
                                <Button Content="Stop script" Click="StopScript_Click"/>
                            </WrapPanel>
                                    <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,8,0,12"/>
                            <TextBlock Text="Account actions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Disconnect" Click="Disconnect_Click"/>
                                <Button Content="Refresh state" Click="Refresh_Click"/>
                            </WrapPanel>
                            <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,8,0,12"/>
                            <TextBlock Text="Script profile" FontWeight="SemiBold"/>
                            <TextBlock Text="Profile name" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,2"/>
                            <TextBox x:Name="ProfileNameBox" Height="30" Padding="7" Background="#0D141C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}"/>
                            <TextBlock Text="Callback name" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,2"/>
                            <TextBox x:Name="CallbackNameBox" Text="move" Height="30" Padding="7" Background="#0D141C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}"/>
                            <TextBlock Text="Interval (ms)" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,2"/>
                            <TextBox x:Name="IntervalBox" Text="1000" Height="30" Padding="7" Background="#0D141C" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}"/>
                            <Button Content="Save profile from selected script" Click="SaveProfile_Click" Margin="0,8,0,8"/>
                            <TextBlock Text="Saved profiles" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                            <ComboBox x:Name="ProfileCombo" Height="30" Margin="0,5,0,8" Background="#0D141C" Foreground="#101820" SelectionChanged="ProfileCombo_SelectionChanged"/>
                            <Button Content="Delete selected profile" Click="DeleteProfile_Click" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Start schedule" Click="StartSchedule_Click"/>
                                <Button Content="Stop schedule" Click="StopSchedule_Click"/>
                                <Button Content="Start on selected accounts" Click="StartScheduleBulk_Click"/>
                                <Button Content="Stop on selected accounts" Click="StopScheduleBulk_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Scheduler invokes the chosen Lua callback repeatedly. Use only callbacks designed to be called on a timer; a running callback must return promptly." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,10,0,10"/>
                            <TextBlock Text="Control logs" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="LogsText" Height="115" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D141C" Foreground="{StaticResource TextMuted}" BorderBrush="{StaticResource PanelBorder}" FontSize="10" Padding="7"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="#0D141C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
