<Window x:Class="NYROX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX Control Center" Height="820" Width="1320"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E151E" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NYROX" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="CONTROL CENTER" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="2,0,0,28"/>
                    <Button Content="Overview" HorizontalContentAlignment="Left"/>
                    <Button Content="Accounts" HorizontalContentAlignment="Left"/>
                    <Button Content="Scripts &amp; Profiles" HorizontalContentAlignment="Left"/>
                    <Button Content="Tasks &amp; Routes" HorizontalContentAlignment="Left"/>
                    <Button Content="Live Logs" HorizontalContentAlignment="Left"/>
                    <Button Content="Game Data" HorizontalContentAlignment="Left"/>
                    <Button Content="Settings" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,0,0,14"/>
                    <TextBlock Text="NYROX ENGINE" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Not connected" Foreground="#E9B66B" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Desktop shell • local control" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Overview" FontSize="29" FontWeight="SemiBold"/>
                    <TextBlock Text="Manage your NYROX runtime and Dofus Unity sessions." Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#18251F" BorderBrush="#285B48" BorderThickness="1" CornerRadius="5" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#E9B66B" Margin="0,0,8,0"/>
                        <TextBlock Text="ENGINE OFFLINE" FontSize="10" FontWeight="Bold" Foreground="#E9B66B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="ACCOUNTS" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Waiting for runtime" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="CONNECTED" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="No live session data" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="ACTIVE TASKS" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="No task scheduler connected" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="16">
                    <StackPanel><TextBlock Text="ENGINE VERSION" Foreground="{StaticResource TextMuted}" FontSize="10"/><TextBlock Text="0.1" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Desktop foundation" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Runtime connection" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="The desktop shell is ready. Account controls will be enabled only after the local Control API is connected." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <Border Background="#0D141C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="14">
                            <StackPanel>
                                <TextBlock Text="CONTROL API" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="Not configured" Margin="0,5,0,0" FontWeight="SemiBold"/>
                                <TextBlock Text="Local-only • Token authenticated • Role-based access" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Next integration: BotManager + per-account LuaScriptHost lifecycle." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="20">
                    <StackPanel>
                        <TextBlock Text="System modules" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,12"><TextBlock Text="Desktop UI" /><TextBlock Text="READY" Foreground="{StaticResource Accent}" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"/></DockPanel>
                        <DockPanel Margin="0,0,0,12"><TextBlock Text="Lua runtime" /><TextBlock Text="EXISTING" Foreground="#E9B66B" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"/></DockPanel>
                        <DockPanel Margin="0,0,0,12"><TextBlock Text="Control API" /><TextBlock Text="PLANNED" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"/></DockPanel>
                        <DockPanel Margin="0,0,0,12"><TextBlock Text="In-game admin" /><TextBlock Text="LATER" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"/></DockPanel>
                        <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,8,0,12"/>
                        <TextBlock Text="No live game actions are triggered by this window." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
