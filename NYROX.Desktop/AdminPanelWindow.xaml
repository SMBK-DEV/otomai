<Window x:Class="NYROX.Desktop.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX Admin • F10" Width="820" Height="520"
        MinWidth="680" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="NYROX ADMIN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="F10 quick control • authenticated local API • owner/admin token" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="LIVE ACCOUNTS" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="AccountCountText" Text="—" FontSize="23" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="CONNECTED" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="ConnectedCountText" Text="—" FontSize="23" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel><TextBlock Text="SCHEDULED" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="ScheduledCountText" Text="—" FontSize="23" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Runtime accounts" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Background="#0D141C" Foreground="{StaticResource TextPrimary}"
                              RowBackground="#111A24" AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionChanged="AccountsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding Id}" Width="1.2*"/>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="1.1*"/>
                            <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="45"/>
                            <DataGridCheckBoxColumn Header="Online" Binding="{Binding Connected}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Fight" Binding="{Binding InFight}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Selected account" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="SelectedAccountText" Text="Select an account." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button Content="Open Map Cells" Click="OpenMapCells_Click"/>
                <Button Content="Stop scheduler" Click="StopScheduler_Click"/>
                <Button Content="Stop Lua interpreter" Click="StopLua_Click"/>
                <Button Content="Disconnect account" Click="Disconnect_Click"/>
                <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,8,0,10"/>
                <TextBlock Text="Admin actions require confirmation. Stop Lua does not forcibly abort a callback already executing." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="#0D141C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Admin panel ready." Foreground="{StaticResource TextMuted}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
