<Window x:Class="NYROX.Desktop.GameInterfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX • Dofus Interface" Width="1180" Height="820"
        MinWidth="980" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#10151D" Foreground="#E8EAF0">
    <Window.Resources>
        <Style TargetType="Button" x:Key="GameButton">
            <Setter Property="Background" Value="#263342"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#536477"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Border" x:Key="PanelFrame">
            <Setter Property="Background" Value="#18212C"/>
            <Setter Property="BorderBrush" Value="#536477"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="NYROX • WORLD INTERFACE" FontSize="21" FontWeight="Bold" Foreground="#D9B36C"/>
                <TextBlock x:Name="AccountInfoText" Text="Waiting for account data…" Foreground="#A8B4C2" FontSize="11"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GameButton}" Content="Refresh" Click="Refresh_Click"/>
                <Button Style="{StaticResource GameButton}" Content="Close" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" Background="#101923" BorderBrush="#536477" Foreground="#E8EAF0">
            <TabItem Header="Dialogue">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelFrame}" Margin="0,0,10,0">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="132" Height="160" Background="#273747" BorderBrush="#7A6746" BorderThickness="2" CornerRadius="6">
                                <Grid>
                                    <TextBlock Text="NPC" FontSize="34" FontWeight="Bold" Foreground="#D9B36C"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="NpcNameText" Text="Aucun dialogue actif" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="NpcIdText" Text="" Foreground="#9BA9B8" FontSize="10"
                                       TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelFrame}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DialogueBodyText" Text="Les dialogues NPC apparaîtront ici quand le client recevra les données du jeu."
                                           FontSize="16" TextWrapping="Wrap" LineHeight="25" Foreground="#F3E8D0"
                                           Margin="8,10,8,18"/>
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="#111923" BorderBrush="#536477" BorderThickness="1"
                                    CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="CHOIX DE DIALOGUE" Foreground="#D9B36C" FontWeight="Bold" FontSize="11" Margin="0,0,0,7"/>
                                    <ItemsControl x:Name="DialogueChoicesList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GameButton}" HorizontalContentAlignment="Left"
                                                        Click="DialogueChoice_Click" Tag="{Binding}">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding State}" DockPanel.Dock="Right"
                                                                   Foreground="#A8B4C2" FontSize="10" Margin="12,0,0,0"/>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="DialogueHintText"
                                               Text="Les réponses actives peuvent être envoyées manuellement après confirmation. Le runtime vérifie le dernier dialogue observé."
                                               Foreground="#E6B96A" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Inventaire">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="InventorySummaryText" Text="Kamas : — • Objets : —"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#D9B36C"/>
                        <TextBlock DockPanel.Dock="Right" Text="Données live du client" Foreground="#9BA9B8" FontSize="10" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelFrame}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ÉQUIPEMENT" FontWeight="Bold" Foreground="#D9B36C" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="EquipmentItemsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111923" BorderBrush="#536477" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Slot}" Foreground="#D9B36C" Width="72" FontSize="10"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="11"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelFrame}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="SAC / INVENTAIRE" FontWeight="Bold" Foreground="#D9B36C" Margin="0,0,0,10"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="InventoryItemsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="InventoryItem_Click" Tag="{Binding}" Padding="2" Margin="3"
                                                        Background="#202D3A" BorderBrush="#62758A" BorderThickness="1" ToolTip="{Binding Tooltip}">
                                                    <Grid Width="68" Height="70">
                                                        <TextBlock Text="{Binding Initial}" FontSize="23" FontWeight="Bold"
                                                                   Foreground="#D9B36C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="8" TextWrapping="Wrap"
                                                                   TextAlignment="Center" VerticalAlignment="Bottom" Margin="2,0,2,12"
                                                                   MaxHeight="22"/>
                                                        <Border Background="#0D141C" CornerRadius="3" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding Quantity}" FontSize="9" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelFrame}">
                            <StackPanel>
                                <TextBlock Text="OBJET SÉLECTIONNÉ" FontWeight="Bold" Foreground="#D9B36C" Margin="0,0,0,12"/>
                                <TextBlock x:Name="SelectedItemNameText" Text="Sélectionnez un objet" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedItemDetailsText" Text="Les détails de l'objet apparaîtront ici." Foreground="#A8B4C2"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Combat">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelFrame}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="FIGHT CONTROLLER • OBSERVATION" Foreground="#D9B36C" FontWeight="Bold"/>
                            <TextBlock x:Name="FightSummaryText" Text="Aucun combat actif"
                                       Foreground="#A8B4C2" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="COMBATTANTS & POSITIONS" Foreground="#D9B36C" FontWeight="Bold" Margin="0,0,0,7"/>
                            <ListView x:Name="FightActorsList" Background="#111923" Foreground="#E8EAF0" BorderBrush="#536477">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Combattant" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                        <GridViewColumn Header="Détails" DisplayMemberBinding="{Binding Details}" Width="310"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelFrame}" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SORTS DU PERSONNAGE" Foreground="#D9B36C" FontWeight="Bold" Margin="0,0,0,7"/>
                            <ListView x:Name="FightSpellsList" Background="#111923" Foreground="#E8EAF0" BorderBrush="#536477">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Sort" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                        <GridViewColumn Header="État / portée" DisplayMemberBinding="{Binding Details}" Width="310"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="3" x:Name="FightHintText" Text="Lecture seule. Aucune action de combat n'est envoyée."
                               Foreground="#E6B96A" FontSize="10" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="HDV">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelFrame}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="HÔTEL DE VENTE • RECHERCHE" Foreground="#D9B36C" FontWeight="Bold"/>
                            <TextBlock x:Name="HdvStateText" Text="En attente de l'ouverture de l'HDV dans le jeu."
                                       Foreground="#A8B4C2" FontSize="11" Margin="0,5,0,8"/>
                            <DockPanel>
                                <Button Style="{StaticResource GameButton}" Content="Rechercher GID" Click="SearchHdv_Click" DockPanel.Dock="Right"/>
                                <TextBox x:Name="HdvGidText" ToolTip="GID du modèle d'objet" VerticalContentAlignment="Center" Padding="7,5"/>
                            </DockPanel>
                            <TextBlock x:Name="HdvHintText" Text="Recherche en lecture seule. Aucun achat ne sera envoyé."
                                       Foreground="#E6B96A" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Margin="0,0,0,10">
                        <TextBlock Text="Les résultats affichés proviennent des événements reçus du serveur. Les prix sont présentés tels quels."
                                   Foreground="#A8B4C2" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelFrame}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="RÉSULTATS OBSERVÉS" Foreground="#D9B36C" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ListView x:Name="HdvResultsList" Background="#111923" Foreground="#E8EAF0" BorderBrush="#536477">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Offre" DisplayMemberBinding="{Binding Label}" Width="150"/>
                                        <GridViewColumn Header="Prix enregistrés (kamas)" DisplayMemberBinding="{Binding Prices}" Width="300"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Échange">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="ExchangeTitleText" Text="Aucun échange actif" FontWeight="Bold" FontSize="15" Foreground="#D9B36C"/>
                        <TextBlock x:Name="ExchangePartnerText" DockPanel.Dock="Right" Text="" Foreground="#A8B4C2"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelFrame}" Margin="0,0,7,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="VOTRE INVENTAIRE" Foreground="#D9B36C" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListView x:Name="ExchangeInventoryList" Background="#111923" Foreground="#E8EAF0" BorderBrush="#536477">
                                    <ListView.View><GridView>
                                        <GridViewColumn Header="Objet" DisplayMemberBinding="{Binding Name}" Width="210"/>
                                        <GridViewColumn Header="Qté" DisplayMemberBinding="{Binding Quantity}" Width="55"/>
                                    </GridView></ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelFrame}" Margin="7,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="OFFRE OBSERVÉE" Foreground="#D9B36C" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListView x:Name="ExchangeOfferList" Background="#111923" Foreground="#E8EAF0" BorderBrush="#536477">
                                    <ListView.View><GridView>
                                        <GridViewColumn Header="Objet" DisplayMemberBinding="{Binding Name}" Width="210"/>
                                        <GridViewColumn Header="Qté" DisplayMemberBinding="{Binding Quantity}" Width="55"/>
                                    </GridView></ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource PanelFrame}" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="ÉTAT DE VALIDATION" Foreground="#D9B36C" FontWeight="Bold"/>
                                <ItemsControl x:Name="ExchangeReadyList" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontSize="11" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Width="340" VerticalAlignment="Center">
                                <TextBlock x:Name="ExchangeHintText"
                                           Text="Les offres sont observées depuis le runtime. Les actions manuelles nécessitent un échange actif et une confirmation."
                                           Foreground="#E6B96A" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,4">
                                    <Button Style="{StaticResource GameButton}" Content="Offrir pile" Click="OfferExchangeStack_Click" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="ExchangeObjectUidText" ToolTip="UID de la pile dans l'inventaire" VerticalContentAlignment="Center" Padding="6,4"/>
                                </DockPanel>
                                <Button Style="{StaticResource GameButton}" Content="Confirmer prêt" Click="ConfirmExchangeReady_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0C131B" BorderBrush="#536477" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Interface prête." Foreground="#9BA9B8" FontSize="10"/>
        </Border>
    </Grid>
</Window>
