<Window x:Class="NYROX.Desktop.ProtocolSnifferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX Protocol Sniffer" Width="1120" Height="720"
        MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PROTOCOL SNIFFER" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ScopeText" Text="Live decoded application messages • current account session"
                           FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start capture" Click="StartCapture_Click"/>
                <Button Content="Stop capture" Click="StopCapture_Click"/>
                <Button Content="Clear" Click="ClearCapture_Click"/>
                <Button Content="Refresh" Click="Refresh_Click"/>
                <Button Content="Close" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="SummaryText" Text="Capture is disabled by default." Margin="0,0,0,10"
                   Foreground="{StaticResource TextMuted}"/>
        <TabControl Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}">
            <TabItem Header="Packet payloads">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.75*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="PacketsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" SelectionChanged="PacketsGrid_SelectionChanged"
                              Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24"
                              AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="48"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="105"/>
                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="72"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Bytes" Binding="{Binding OriginalBytes}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Margin="10,0,0,0" Background="#0D141C" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="5" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SELECTED PAYLOAD • HEX" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="PayloadDetailText" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12" Background="#0B1017"
                                     Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}"
                                     Text="Select a packet to inspect its captured protobuf payload."/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Message types">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="INCOMING PROTOCOL TYPES" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="IncomingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24"
                                      AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Message type" Binding="{Binding Type}" Width="*"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="UNHANDLED DOMAIN EVENTS" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="UnhandledGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24"
                                      AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Message type" Binding="{Binding Type}" Width="*"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Handler routing">
                <Grid Margin="10">
                    <DataGrid x:Name="RoutingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24"
                              AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Protocol type" Binding="{Binding Type}" Width="2*"/>
                            <DataGridTextColumn Header="Consuming handler" Binding="{Binding Handler}" Width="2*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="#0D141C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                CornerRadius="5" Padding="9" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Observer ready." Foreground="{StaticResource TextMuted}" FontSize="11"/>
        </Border>
    </Grid>
</Window>