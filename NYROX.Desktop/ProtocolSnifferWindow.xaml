<Window x:Class="NYROX.Desktop.ProtocolSnifferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYROX Protocol Sniffer" Width="920" Height="620"
        MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PROTOCOL SNIFFER" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ScopeText" Text="Read-only observer • current session • message type names only"
                           FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/>
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="SummaryText" Text="Waiting for observer data..." Margin="0,0,0,10"
                   Foreground="{StaticResource TextMuted}"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INCOMING PROTOCOL TYPES" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="IncomingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24"
                              AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Message type" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="UNHANDLED DOMAIN EVENTS" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="UnhandledGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="#0D141C" Foreground="{StaticResource TextPrimary}" RowBackground="#111A24"
                              AlternatingRowBackground="#14202B" BorderBrush="{StaticResource PanelBorder}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Message type" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#0D141C" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                CornerRadius="5" Padding="9" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Observer ready." Foreground="{StaticResource TextMuted}" FontSize="11"/>
        </Border>
    </Grid>
</Window>